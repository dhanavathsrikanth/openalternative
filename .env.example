# This can be found on dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replaceThisWithRealValues
CLERK_SECRET_KEY=sk_test_replaceThisWithRealValues

# Get your connection string from console.neon.tech
# Pooled endpoint (-pooler) — used by the app at runtime (transaction-mode pooling).
DATABASE_URL='postgresql://neondb_owner:replacethis@ep-adj-noun-123245-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require'

# Direct (non-pooled) endpoint — used by drizzle-kit migrations and one-off scripts.
DATABASE_URL_UNPOOLED='postgresql://neondb_owner:replacethis@ep-adj-noun-123245.us-east-1.aws.neon.tech/neondb?sslmode=require'

# Can be found in the webhook endpoints section for
# your application dashboard.clerk.com
CLERK_WEBHOOK_SECRET='whsec_foobar'

# Set log level to trace. Defaults to "info" if not explicitly defined
LOG_LEVEL=trace

# PostHog — project API token + ingestion host. Find the token in your PostHog
# project settings (https://us.posthog.com). In production these are set in the
# Vercel dashboard (Settings > Environment Variables), not in this file.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_replaceThisWithRealValues
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry DSN — find it in Sentry project settings (Settings → Client Keys)
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# Sentry environment tag — set per environment (e.g. "production", "staging")
# On Vercel this falls back to VERCEL_ENV automatically.
# SENTRY_ENVIRONMENT=staging

# Cloudflare Images — find these in the Cloudflare dashboard:
#   Account ID: right sidebar of any page
#   API Token: My Profile > API Tokens > Create Token (Permissions: Account > Cloudflare Images > Edit)
#   Account Hash: Images > Overview > Stats & Storage > API > Account Hash
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token
CLOUDFLARE_ACCOUNT_HASH=your_account_hash
