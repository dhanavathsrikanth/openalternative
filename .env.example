# Set log level to trace. Defaults to "info" if not explicitly defined
LOG_LEVEL=trace

# PostHog — project API token + ingestion host. Find the token in your PostHog
# project settings (https://us.posthog.com). In production these are set in the
# Vercel dashboard (Settings > Environment Variables), not in this file.
