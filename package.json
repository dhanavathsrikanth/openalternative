{
  "name": "neon-clerk-discord",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "drizzle:generate": "drizzle-kit generate:pg",
    "drizzle:push": "drizzle-kit push:pg",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,mdx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,mdx}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "seed": "tsx --require dotenv/config seed.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^4.29.9",
    "@clerk/types": "^3.62.1",
    "@neondatabase/serverless": "^0.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.30.2",
    "env-var": "^7.4.1",
    "lucide-react": "^1.25.0",
    "next": "14.1.3",
    "pino": "^8.19.0",
    "react": "^18",
    "react-dom": "^18",
    "svix": "^1.21.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.20.14",
    "eslint": "^8",
    "eslint-config-next": "14.1.3",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.7.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
